{
  "name": "business-mentor",
  "productName": "My BUSINESS Mentor",
  "version": "1.0.0",
  "private": true,
  "description": "Speak or type your business idea; get a concept, 20 hard questions with scrutiny and true stories read aloud, and local registration steps.",
  "main": "electron/main.js",
  "author": {
    "name": "BajanBob",
    "email": "you@example.com"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "start:kiosk": "electron . --kiosk",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:pi": "electron-builder --linux AppImage deb --arm64 --armv7l",
    "dist:win": "electron-builder --win nsis portable --x64 --arm64",
    "dist:mac": "electron-builder --mac dmg zip --universal",
    "android:add": "cap add android && node scripts/patch-native.js android && cap sync android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "ios:add": "cap add ios --packagemanager SPM && node scripts/patch-native.js ios && cap sync ios",
    "ios:open": "cap open ios"
  },
  "build": {
    "appId": "com.bajanbob.businessmentor",
    "productName": "My BUSINESS Mentor",
    "copyright": "Copyright © 2026 BajanBob",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "www/**",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "My BUSINESS Mentor",
      "artifactName": "My-BUSINESS-Mentor-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "My-BUSINESS-Mentor-Portable-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": null
    }
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor-community/text-to-speech": "^6.0.0"
  }
}
